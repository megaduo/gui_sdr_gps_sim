+"""Hardware-free Pluto helper tests. Run: python -m unittest discover -s tests -p test_pluto_bridge.py -v"""
+
+import importlib.util
+import io
+import subprocess
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+
+HELPER = Path(__file__).resolve().parents[1] / "src/gps_sim/pluto_bridge.py"
+SPEC = importlib.util.spec_from_file_location("pluto_bridge", HELPER)
+bridge = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(bridge)
+
+
+class FakeRadio:
+    def __init__(self):
+        self.blocks = []
+        self.destroyed = 0
+        self._ctx = types.SimpleNamespace(set_timeout=lambda value: None)
+
+    def tx(self, data):
+        self.blocks.append(data.copy())
+
+    def tx_destroy_buffer(self):
+        self.destroyed += 1
+
+
+class ShortReader(io.BytesIO):
+    def read(self, count=-1):
+        return super().read(min(count, 997))
+
+
+class PlutoBridgeTests(unittest.TestCase):
+    def test_all_signed_values_and_iq_order(self):
+        signed = np.arange(-128, 128, dtype=np.int16).astype(np.int8)
+        result = bridge.convert_sc8(signed.tobytes())
+        np.testing.assert_array_equal(result.real, signed[0::2].astype(np.int16) * 256)
+        np.testing.assert_array_equal(result.imag, signed[1::2].astype(np.int16) * 256)
+        self.assertEqual(result.dtype, np.complex64)
+        self.assertEqual(result[0], complex(-32768, -32512))
+        self.assertEqual(result[-1], complex(32256, 32512))
+
+    def test_short_reads_and_multiple_fresh_blocks(self):
+        radio = FakeRadio()
+        replies, sleeps = [], []
+        data = bytes([1, 255]) * (bridge.BLOCK_BYTES // 2)
+        bridge.stream(radio, ShortReader(data + bytes(bridge.BLOCK_BYTES)), replies.append,
+                      3_000_000, sleep=sleeps.append)
+        self.assertEqual(replies, ["READY", "OK", "OK", "DONE"])
+        self.assertEqual(len(radio.blocks), 2)
+        np.testing.assert_array_equal(radio.blocks[0], 256 - 256j)
+        np.testing.assert_array_equal(radio.blocks[1], 0)
+        self.assertEqual(radio.destroyed, 1)
+        self.assertAlmostEqual(sleeps[0], 4 * 131072 / 3_000_000)
+
+    def test_truncated_input_cleans_up_without_acknowledgement(self):
+        radio, replies = FakeRadio(), []
+        with self.assertRaisesRegex(ValueError, "Truncated"):
+            bridge.stream(radio, io.BytesIO(b"x"), replies.append, 3_000_000)
+        self.assertEqual(replies, ["READY"])
+        self.assertEqual(radio.destroyed, 1)
+
+    def test_tx_failure_cleans_up_without_done(self):
+        radio, replies = FakeRadio(), []
+        radio.tx = lambda samples: (_ for _ in ()).throw(OSError("device disconnected"))
+        with self.assertRaisesRegex(OSError, "disconnected"):
+            bridge.stream(radio, io.BytesIO(bytes(bridge.BLOCK_BYTES)), replies.append, 3_000_000)
+        self.assertEqual(replies, ["READY"])
+        self.assertEqual(radio.destroyed, 1)
+
+    def run_main(self, radio):
+        def open_radio(*, uri):
+            self.assertEqual(uri, "usb:1.2.5")
+            # Library output must not corrupt the protocol.
+            print("libiio diagnostic")
+            return radio
+
+        argv = [str(HELPER), "--uri", "usb:1.2.5", "--rate", "3000000",
+                "--frequency", "1575420000", "--bandwidth", "2500000",
+                "--gain", "-80.5", "--timeout-ms", "5000"]
+        stdout, stderr = io.StringIO(), io.StringIO()
+        stdin = types.SimpleNamespace(buffer=io.BytesIO())
+        with patch.dict(sys.modules, {"adi": types.SimpleNamespace(Pluto=open_radio)}), \
+             patch.object(sys, "argv", argv), patch.object(sys, "stdin", stdin), \
+             patch.object(sys, "stdout", stdout), patch.object(sys, "stderr", stderr):
+            bridge.main()
+        return stdout.getvalue(), stderr.getvalue()
+
+    def test_main_configures_radio_and_separates_diagnostics(self):
+        radio = FakeRadio()
+        stdout, stderr = self.run_main(radio)
+        self.assertEqual(stdout, "READY\nDONE\n")
+        self.assertIn("libiio diagnostic", stderr)
+        self.assertEqual(radio.sample_rate, 3_000_000)
+        self.assertEqual(radio.tx_lo, 1_575_420_000)
+        self.assertEqual(radio.tx_rf_bandwidth, 2_500_000)
+        self.assertEqual(radio.tx_hardwaregain_chan0, -80.5)
+        self.assertFalse(radio.tx_cyclic_buffer)
+        self.assertEqual(radio.tx_enabled_channels, [0])
+        self.assertGreater(radio.destroyed, 0)
+
+    def test_rate_readback_mismatch_is_fatal_and_cleans_up(self):
+        class WrongRate(FakeRadio):
+            @property
+            def sample_rate(self):
+                return 4_000_000
+
+            @sample_rate.setter
+            def sample_rate(self, value):
+                pass
+
+        radio = WrongRate()
+        with self.assertRaisesRegex(ValueError, "readback"):
+            self.run_main(radio)
+        self.assertEqual(radio.blocks, [])
+        self.assertEqual(radio.destroyed, 1)
+
+    def test_missing_dependency_fails_in_subprocess_without_hardware(self):
+        # Isolated mode omits site-packages, guaranteeing no accidental device access.
+        result = subprocess.run(
+            [sys.executable, "-I", "-S", str(HELPER), "--uri", "ip:invalid",
+             "--rate", "3000000", "--frequency", "1575420000", "--bandwidth", "3000000",
+             "--gain", "-80", "--timeout-ms", "1000"],
+            input=b"", capture_output=True, timeout=5, check=False)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, b"")
+        self.assertIn(b"Pluto TX failed", result.stderr)
+        self.assertIn(b"adi", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
