@@ -0,0 +1,148 @@
+"""Hardware-free Pluto helper tests. Run: python -m unittest discover -s tests -p test_pluto_bridge.py -v"""
+
+import importlib.util
+import io
+import subprocess
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+
+HELPER = Path(__file__).resolve().parents[1] / "src/gps_sim/pluto_bridge.py"
+SPEC = importlib.util.spec_from_file_location("pluto_bridge", HELPER)
+bridge = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(bridge)
+
+
+class FakeRadio:
+    def __init__(self):
+        self.blocks = []
+        self.destroyed = 0
+        self._ctx = types.SimpleNamespace(set_timeout=lambda value: None)
+        self.kernel_buffers = None
+        self._txdac = types.SimpleNamespace(set_kernel_buffers_count=self.set_buffers)
+
+    def set_buffers(self, count):
+        self.kernel_buffers = count
+
+    def tx(self, data):
+        self.blocks.append(data.copy())
+
+    def tx_destroy_buffer(self):
+        self.destroyed += 1
+
+
+class ShortReader(io.BytesIO):
+    def read(self, count=-1):
+        return super().read(min(count, 997))
+
+
+class PlutoBridgeTests(unittest.TestCase):
+    def test_all_signed_values_and_iq_order(self):
+        signed = np.arange(-32768, 32768, dtype="<i2")
+        result = bridge.convert_sc16(signed.tobytes())
+        np.testing.assert_array_equal(result.real, signed[0::2])
+        np.testing.assert_array_equal(result.imag, signed[1::2])
+        self.assertEqual(result.dtype, np.complex64)
+        self.assertEqual(result[0], complex(-32768, -32767))
+        self.assertEqual(result[-1], complex(32766, 32767))
+
+    def test_sc16_rejects_partial_complex_sample(self):
+        for partial in [b"x", b"xx", b"xxx"]:
+            with self.assertRaisesRegex(ValueError, "Truncated"):
+                bridge.convert_sc16(partial)
+
+    def test_short_reads_and_multiple_fresh_blocks(self):
+        radio = FakeRadio()
+        replies, sleeps = [], []
+        data = bytes([1, 0, 255, 255]) * (bridge.BLOCK_BYTES // 4)
+        bridge.stream(radio, ShortReader(data + bytes(bridge.BLOCK_BYTES)), replies.append,
+                      3_000_000, sleep=sleeps.append)
+        self.assertEqual(replies, ["READY", "OK", "OK", "DONE"])
+        self.assertEqual(len(radio.blocks), 2)
+        np.testing.assert_array_equal(radio.blocks[0], 1 - 1j)
+        np.testing.assert_array_equal(radio.blocks[1], 0)
+        self.assertEqual(radio.destroyed, 1)
+        self.assertAlmostEqual(sleeps[0], 4 * 65536 / 3_000_000)
+
+    def test_truncated_input_cleans_up_without_acknowledgement(self):
+        radio, replies = FakeRadio(), []
+        with self.assertRaisesRegex(ValueError, "Truncated"):
+            bridge.stream(radio, io.BytesIO(b"x"), replies.append, 3_000_000)
+        self.assertEqual(replies, ["READY"])
+        self.assertEqual(radio.destroyed, 1)
+
+    def test_tx_failure_cleans_up_without_done(self):
+        radio, replies = FakeRadio(), []
+        radio.tx = lambda samples: (_ for _ in ()).throw(OSError("device disconnected"))
+        with self.assertRaisesRegex(OSError, "disconnected"):
+            bridge.stream(radio, io.BytesIO(bytes(bridge.BLOCK_BYTES)), replies.append, 3_000_000)
+        self.assertEqual(replies, ["READY"])
+        self.assertEqual(radio.destroyed, 1)
