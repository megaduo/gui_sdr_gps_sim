+++ b/src/gps_sim/pluto.rs
@@ -0,0 +1,372 @@
+//! Supervised, bounded sc16 pipe to the embedded `pyadi-iio` transmitter.
+
+use std::io::{BufRead as _, BufReader, Read as _, Write as _};
+use std::process::{Child, Command, Stdio};
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, Ordering},
+    mpsc::{self, Receiver, RecvTimeoutError, Sender},
+};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use super::SimError;
+
+const HELPER: &str = include_str!("pluto_bridge.py");
+const STDERR_LIMIT: usize = 8192;
+
+/// Runtime settings for the optional ADALM-Pluto output backend.
+#[derive(Debug, Clone)]
+pub struct PlutoConfig {
+    /// libiio URI, e.g. `ip:192.168.2.1` or `usb:1.2.5`.
+    pub uri: String,
+    /// Python executable path only (no arguments); may point into a virtualenv.
+    pub python: String,
+    /// TX hardware gain in dB, -89 through 0 (negative means attenuation).
+    pub gain_db: f64,
+    /// Per-operation timeout; also bounds stalled pipe writes and shutdown.
+    pub timeout_ms: u32,
+}
+
+impl Default for PlutoConfig {
+    fn default() -> Self {
+        Self {
+            uri: "ip:192.168.2.1".into(),
+            python: "auto".into(),
+            gain_db: -80.0,
+            timeout_ms: 10_000,
+        }
+    }
+}
+
+impl PlutoConfig {
+    pub(super) fn validate(
+        &self,
+        rate: f64,
+        frequency: u64,
+        bandwidth: u32,
+    ) -> Result<(), SimError> {
+        let message = if self.uri.trim().is_empty() || self.python.trim().is_empty() {
+            Some("Pluto URI and Python executable must not be empty")
+        } else if !self.gain_db.is_finite() || !(-89.0..=0.0).contains(&self.gain_db) {
+            Some("Pluto TX gain must be between -89 and 0 dB")
+        } else if !rate.is_finite()
+            || !(1_000_000.0..=20_000_000.0).contains(&rate)
+            || rate.fract() != 0.0
+        {
+            Some("Pluto sample rate must be a whole number between 1 and 20 MSPS")
+        } else if !(325_000_000..=3_800_000_000).contains(&frequency) {
+            Some("Pluto centre frequency must be within the stock AD9363 range (325–3800 MHz)")
+        } else if !(200_000..=20_000_000).contains(&bandwidth) {
+            Some("Pluto TX bandwidth must be between 200 kHz and 20 MHz")
+        } else if !(100..=60_000).contains(&self.timeout_ms) {
+            Some("Pluto timeout must be between 100 and 60000 milliseconds")
+        } else {
+            None
+        };
+        match message {
+            Some(message) => Err(SimError::Config(message.into())),
+            None => Ok(()),
+        }
+    }
+}
+
+pub(super) fn normalize_uri(uri: &str) -> String {
+    let uri = uri.trim();
+    if uri.contains(':') {
+        uri.into()
+    } else {
+        format!("ip:{uri}")
+    }
+}
+
+fn resolve_python(requested: &str, executable_dir: &std::path::Path) -> std::path::PathBuf {
+    if !matches!(requested, "auto" | "python" | "python3") {
+        return requested.into();
+    }
+    let bundled = executable_dir.join("pluto-runtime").join("python.exe");
+    if cfg!(windows) && bundled.is_file() {
+        bundled
+    } else if requested == "auto" {
+        if cfg!(windows) { "python" } else { "python3" }.into()
+    } else {
+        requested.into()
+    }
+}
+
+/// Owns and reaps the helper even on cancellation, timeout, or unwinding.
+pub(super) struct PlutoTx {
+    child: Child,
+    commands: Sender<Option<Vec<u8>>>,
+    replies: Receiver<Result<(), String>>,
+    stderr: Arc<Mutex<Vec<u8>>>,
+    threads: Vec<JoinHandle<()>>,
+    timeout: Duration,
+}
+
+impl PlutoTx {
+    pub(super) fn open(
+        config: &PlutoConfig,
+        rate: f64,
+        frequency: u64,
+        bandwidth: u32,
+        stop: &AtomicBool,
+    ) -> Result<Self, SimError> {
+        config.validate(rate, frequency, bandwidth)?;
+        if stop.load(Ordering::Relaxed) {
+            return Err(SimError::Aborted);
+        }
+        let executable = std::env::current_exe()?;
+        let directory = executable
+            .parent()
+            .ok_or_else(|| SimError::Config("Cannot locate application directory".into()))?;
+        let mut command = Command::new(resolve_python(&config.python, directory));
+        command.args([
+            "-u",
+            "-c",
+            HELPER,
+            "--uri",
+            &normalize_uri(&config.uri),
+            "--rate",
+            &format!("{rate:.0}"),
+            "--frequency",
+            &frequency.to_string(),
+            "--bandwidth",
+            &bandwidth.to_string(),
+            "--gain",
+            &config.gain_db.to_string(),
+            "--timeout-ms",
+            &config.timeout_ms.to_string(),
+        ]);
+        let mut tx = Self::spawn(command, Duration::from_millis(u64::from(config.timeout_ms)))?;
+        // Importing scientific Python and configuring the FIR may take longer
+        // than one transfer. This deadline still covers a hung device open.
+        tx.wait_reply(stop, tx.timeout + Duration::from_secs(20))?;
+        Ok(tx)
+    }
+
+    fn spawn(mut command: Command, timeout: Duration) -> Result<Self, SimError> {
+        command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt as _;
+            command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+        }
+        let mut child = command.spawn().map_err(|error| {
+            SimError::Pluto(format!("Cannot launch Python: {error}. Set the Pluto Python executable and install pyadi-iio, numpy and libiio."))
+        })?;
+        // Stdio::piped guarantees these handles after a successful spawn.
+        let mut input = child.stdin.take().expect("piped stdin");
+        let mut output = BufReader::new(child.stdout.take().expect("piped stdout"));
+        let mut errors = child.stderr.take().expect("piped stderr");
+        let stderr = Arc::new(Mutex::new(Vec::new()));
+        let captured = Arc::clone(&stderr);
+        let error_thread = std::thread::spawn(move || {
+            let mut block = [0_u8; 1024];
+            while let Ok(count) = errors.read(&mut block) {
+                if count == 0 {
+                    break;
+                }
+                let mut tail = captured.lock().unwrap_or_else(|error| error.into_inner());
+                tail.extend(block.iter().take(count));
+                let excess = tail.len().saturating_sub(STDERR_LIMIT);
+                tail.drain(..excess);
+            }
+        });
+        let (commands, incoming) = mpsc::channel::<Option<Vec<u8>>>();
+        let (reply, replies) = mpsc::channel();
+        let io_thread = std::thread::spawn(move || {
+            let result = expect_reply(&mut output, "READY");
+            let failed = result.is_err();
+            if reply.send(result).is_err() || failed {
+                return;
+            }
+            while let Ok(message) = incoming.recv() {
+                let Some(bytes) = message else {
+                    drop(input); // EOF: drain and destroy TX buffer, then DONE.
+                    let _sent = reply.send(expect_reply(&mut output, "DONE"));
+                    return;
+                };
+                let result = input
+                    .write_all(&bytes)
+                    .map_err(|error| error.to_string())
+                    .and_then(|()| expect_reply(&mut output, "OK"));
+                let failed = result.is_err();
+                if reply.send(result).is_err() || failed {
+                    return;
+                }
+            }
+        });
+        Ok(Self {
+            child,
+            commands,
+            replies,
+            stderr,
+            threads: vec![error_thread, io_thread],
+            timeout,
+        })
+    }
+
+    fn wait_reply(&mut self, stop: &AtomicBool, timeout: Duration) -> Result<(), SimError> {
+        let started = Instant::now();
+        loop {
+            if stop.load(Ordering::Relaxed) {
+                return Err(SimError::Aborted);
+            }
+            if started.elapsed() >= timeout {
+                return Err(self.failure("Pluto helper timed out"));
+            }
+            match self.replies.recv_timeout(Duration::from_millis(25)) {
+                Ok(Ok(())) => return Ok(()),
+                Ok(Err(message)) => return Err(self.failure(&message)),
+                Err(RecvTimeoutError::Disconnected) => {
+                    return Err(self.failure("Pluto helper exited"));
+                }
+                Err(RecvTimeoutError::Timeout) => {}
+            }
+        }
+    }
+
+    fn failure(&mut self, message: &str) -> SimError {
+        self.terminate();
+        let tail = self
+            .stderr
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        SimError::Pluto(format!("{message}: {}", String::from_utf8_lossy(&tail)))
+    }
+
+    pub(super) fn write(&mut self, samples: &[i16], stop: &AtomicBool) -> Result<(), SimError> {
+        let bytes = samples
+            .iter()
+            .flat_map(|sample| sample.to_le_bytes())
+            .collect();
+        self.commands
+            .send(Some(bytes))
+            .map_err(|error| SimError::Pluto(error.to_string()))?;
+        self.wait_reply(stop, self.timeout)
+    }
+
+    pub(super) fn finish(&mut self, stop: &AtomicBool) -> Result<(), SimError> {
+        self.commands
+            .send(None)
+            .map_err(|error| SimError::Pluto(error.to_string()))?;
+        self.wait_reply(stop, self.timeout)?;
+        let started = Instant::now();
+        loop {
+            if stop.load(Ordering::Relaxed) {
+                return Err(SimError::Aborted);
+            }
+            if let Some(status) = self.child.try_wait()? {
+                return if status.success() {
+                    Ok(())
+                } else {
+                    Err(self.failure("Pluto helper failed"))
+                };
+            }
+            if started.elapsed() >= self.timeout {
+                return Err(self.failure("Pluto helper did not exit"));
+            }
+            std::thread::sleep(Duration::from_millis(25));
+        }
+    }
+
+    fn terminate(&mut self) {
+        let _killed = self.child.kill();
+        let _reaped = self.child.wait();
+        // Wake an idle I/O thread even when no samples were ever sent.
+        let _sent = self.commands.send(None);
+        for thread in self.threads.drain(..) {
+            let _joined = thread.join();
+        }
+    }
+}
+
+impl Drop for PlutoTx {
+    fn drop(&mut self) {
+        self.terminate();
+    }
+}
+
+fn expect_reply(reader: &mut impl std::io::BufRead, expected: &str) -> Result<(), String> {
+    // A malformed helper must not make us allocate without limit.
+    let mut line = String::new();
+    reader
+        .take(256)
+        .read_line(&mut line)
+        .map_err(|error| error.to_string())?;
+    if line.trim() == expected {
+        Ok(())
+    } else {
+        Err(format!("Expected Pluto {expected}, received {line:?}"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{PlutoConfig, normalize_uri, resolve_python};
+
+    #[test]
+    fn explicit_python_is_preserved_and_bundle_is_found() {
+        let directory = tempfile::tempdir().expect("temporary app directory");
+        let bundle = directory.path().join("pluto-runtime");
+        std::fs::create_dir(&bundle).expect("runtime directory");
+        let python = bundle.join("python.exe");
+        std::fs::write(&python, []).expect("runtime executable marker");
+        assert_eq!(
+            resolve_python("custom-python", directory.path()),
+            std::path::PathBuf::from("custom-python")
+        );
+        if cfg!(windows) {
+            assert_eq!(resolve_python("auto", directory.path()), python);
+            assert_eq!(resolve_python("python", directory.path()), python);
+        }
+    }
+
+    #[test]
+    fn accepts_defaults_and_preserves_iio_uris() {
+        assert!(
+            PlutoConfig::default()
+                .validate(3_000_000.0, 1_575_420_000, 3_000_000)
+                .is_ok()
+        );
+        assert_eq!(normalize_uri(" 192.168.2.1 "), "ip:192.168.2.1");
+        assert_eq!(normalize_uri("usb:1.2.5"), "usb:1.2.5");
+        assert_eq!(normalize_uri("ip:pluto.local"), "ip:pluto.local");
+    }
+
+    #[test]
+    fn rejects_invalid_rf_and_runtime_settings() {
+        let mut config = PlutoConfig::default();
+        for gain in [1.0, -90.0, f64::NAN] {
+            config.gain_db = gain;
+            assert!(
+                config
+                    .validate(3_000_000.0, 1_575_420_000, 3_000_000)
+                    .is_err()
+            );
+        }
+        config.gain_db = -80.0;
+        for rate in [0.0, f64::NAN, 999_999.0, 20_000_001.0, 3_000_000.5] {
+            assert!(config.validate(rate, 1_575_420_000, 3_000_000).is_err());
+        }
+        assert!(config.validate(3_000_000.0, 1, 3_000_000).is_err());
+        assert!(config.validate(3_000_000.0, 1_575_420_000, 1).is_err());
+        config.timeout_ms = 0;
+        assert!(
+            config
+                .validate(3_000_000.0, 1_575_420_000, 3_000_000)
+                .is_err()
+        );
+        config.timeout_ms = 10_000;
+        config.uri.clear();
+        assert!(
+            config
+                .validate(3_000_000.0, 1_575_420_000, 3_000_000)
+                .is_err()
+        );
+    }
+}
