+++ b/src/gps_sim/pluto_bridge.py
@@ -0,0 +1,93 @@
+"""Embedded Pluto TX helper. stdin: fixed-size sc8 blocks; stdout: acknowledgements.
+
+This is launched by Rust using an argument list, never a shell. Imports are lazy
+so protocol and error tests can use a fake radio without libiio or hardware.
+"""
+
+import argparse
+import contextlib
+import sys
+import time
+
+BLOCK_BYTES = 262144
+
+
+def read_block(source):
+    """Accumulate short pipe reads; reject a truncated block rather than repeat it."""
+    data = bytearray()
+    while len(data) < BLOCK_BYTES:
+        part = source.read(BLOCK_BYTES - len(data))
+        if not part:
+            if data:
+                raise ValueError("Truncated Pluto IQ block")
+            return None
+        data.extend(part)
+    return data
+
+
+def convert_sc8(data):
+    """Map signed interleaved sc8 to Pluto's signed 16-bit DAC input range."""
+    import numpy as np
+
+    raw = np.frombuffer(data, dtype=np.int8).astype(np.float32)
+    # pyadi-iio takes unnormalised complex values, then casts to int16.
+    # -128 -> -32768; 127 -> 32512. Preserve order, sign and relative amplitude.
+    return (raw[0::2] + 1j * raw[1::2]) * 256.0
+
+
+def stream(radio, source, reply, rate, sleep=time.sleep):
+    """Non-cyclic streaming; one acknowledgement after each successful push."""
+    try:
+        reply("READY")
+        while (data := read_block(source)) is not None:
+            radio.tx(convert_sc8(data))
+            reply("OK")
+        # libiio push can return while the final buffers are still queued.
+        # Allow the bounded kernel queue to drain before destroying the buffer.
+        sleep(4 * (BLOCK_BYTES // 2) / rate)
+    finally:
+        radio.tx_destroy_buffer()
+    reply("DONE")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--uri", required=True)
+    parser.add_argument("--rate", required=True, type=int)
+    parser.add_argument("--frequency", required=True, type=int)
+    parser.add_argument("--bandwidth", required=True, type=int)
+    parser.add_argument("--gain", required=True, type=float)
+    parser.add_argument("--timeout-ms", required=True, type=int)
+    args = parser.parse_args()
+    protocol = sys.stdout
+
+    def reply(message):
+        print(message, file=protocol, flush=True)
+
+    # Keep dependency/library output out of the machine-readable stdout pipe.
+    with contextlib.redirect_stdout(sys.stderr):
+        import adi
+
+        radio = adi.Pluto(uri=args.uri)
+        try:
+            radio._ctx.set_timeout(args.timeout_ms)
+            radio.tx_enabled_channels = [0]
+            radio.tx_cyclic_buffer = False
+            radio.sample_rate = args.rate
+            radio.tx_lo = args.frequency
+            radio.tx_rf_bandwidth = args.bandwidth
+            radio.tx_hardwaregain_chan0 = args.gain
+            if int(radio.sample_rate) != args.rate:
+                raise ValueError("Pluto sample-rate readback differs from IQ generation rate")
+            stream(radio, sys.stdin.buffer, reply, args.rate)
+        finally:
+            # Also covers failures during configuration; never leave a cyclic TX.
+            radio.tx_destroy_buffer()
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        print(f"Pluto TX failed: {error}", file=sys.stderr, flush=True)
+        sys.exit(1)
